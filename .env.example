# ===========================================================================
# AU vs AI — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ===========================================================================

# --- Supabase -------------------------------------------------------------
# Dashboard -> Project Settings -> Data API
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Dashboard -> Project Settings -> API Keys -> "anon" / "publishable"
# PUBLIC. Safe in the browser. Bound by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard -> Project Settings -> API Keys -> "service_role" (click Reveal)
# SECRET. Bypasses ALL security rules. Server only.
# Never paste this into chat, a screenshot, or any client-side file.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------
# The final QR URL. Must match Supabase Auth -> URL Configuration -> Site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) -------------------------------------------------------
# resend.com -> API Keys. Same key you pasted into Supabase's SMTP password.
# Used only by scripts/check-resend.mjs for diagnostics.
RESEND_API_KEY=

# --- Admin ----------------------------------------------------------------
# Comma-separated AU emails seeded into the admins table on first run.
# Authoritative admin access is the admins table, not this variable.
ADMIN_EMAILS=

# --- Drawing model --------------------------------------------------------
# Served from /public/models/quickdraw/model.json
NEXT_PUBLIC_MODEL_URL=/models/quickdraw/model.json

# DEVELOPMENT ONLY. Set to 1 to let the fake classifier stand in when the real
# model will not load. Ignored in production builds, where a model that fails
# to load always fails the device check and no attempt is started.
# NEXT_PUBLIC_ALLOW_MOCK_CLASSIFIER=1
