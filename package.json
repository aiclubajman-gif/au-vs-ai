{
  "name": "au-vs-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:db": "node --env-file=.env.local scripts/verify-db.mjs",
    "test:email": "node --env-file=.env.local scripts/test-email.mjs",
    "check:resend": "node --env-file=.env.local scripts/check-resend.mjs",
    "seed:dev": "node --env-file=.env.local scripts/seed-dev.mjs",
    "seed:clear": "node --env-file=.env.local scripts/seed-dev.mjs --clear",
    "seed:dataset": "node --env-file=.env.local scripts/seed-dataset.mjs",
    "seed:dataset:sql": "node scripts/seed-dataset.mjs --sql",
    "make:admin": "node --env-file=.env.local scripts/make-admin.mjs",
    "check:push": "node scripts/pre-push-check.mjs",
    "load:images": "node --env-file=.env.local scripts/load-images.mjs",
    "load:images:dry": "node --env-file=.env.local scripts/load-images.mjs --dry"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tensorflow/tfjs": "^4.22.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
