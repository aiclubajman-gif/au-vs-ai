# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
/coverage

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===========================================================================
# SECRETS — never commit these.
# .env.local holds SUPABASE_SERVICE_ROLE_KEY, which bypasses every security
# rule in the database. If it reaches a public repo, rotate it immediately in
# Supabase -> Project Settings -> API Keys.
# ===========================================================================
.env
.env*.local
.env.local
.env.production

# typescript
*.tsbuildinfo

# vercel
.vercel

# The trained model MUST be committed — Vercel builds from git, so an ignored
# .bin means the deployed site has no model and every student silently gets the
# fallback. It is ~440KB, which is fine to version.
# (Previously ignored here; removed deliberately.)

# Source images are loaded into Supabase Storage, not committed. Forty photos
# would bloat the repo, and swapping one should not need a redeploy.
# The README and folder structure ARE committed.
/images/real/*
/images/ai/*
/images/manifest.csv
!/images/README.md

# Design masters, approved mockups and QA captures. Multi-megabyte and never
# loaded by the app; only the optimized derivatives under public/ ship.
/design-source/

# Written by `next dev` (node_modules/next/dist/server/lib/generate-agent-files.js)
# whenever it detects an AI coding agent, and re-created after any deletion.
# AGENTS.md holds only the managed nextjs-agent-rules block and CLAUDE.md only
# an @AGENTS.md include: neither has ever carried project documentation, and
# both are regenerated from the installed Next.js version. Ours lives in
# README.md, TODO.md and docs/.
/AGENTS.md
/CLAUDE.md
